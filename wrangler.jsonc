{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gansunailongdaxue-com",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  "previews": {
    "observability": {
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1,
        "persist": true
      },
      "issues": {
        "enabled": true
      }
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  }
}
